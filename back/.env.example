PORT=4000
CLIENT_ORIGIN=http://localhost:5173

FIREBASE_PROJECT_ID=delegado-usuarios
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@delegado-usuarios.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_WITH_ROTATED_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=delegado-usuarios.firebasestorage.app

# Azure OpenAI vision model for expression classification
AZURE_OPENAI_ENDPOINT=https://your-openai-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_DEPLOYMENT=your_gpt4o_or_gpt41_deployment
AZURE_OPENAI_API_VERSION=2024-02-15-preview
CAMERA_SNAPSHOT_MAX_BYTES=10485760

# Alternative to the 3 variables above:
# FIREBASE_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json

BCRYPT_ROUNDS=12
