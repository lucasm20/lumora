rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() &&
        (request.auth.uid == userId || request.auth.token.userDocId == userId);
    }

    function isHrForCompany(companyName) {
      return signedIn() &&
        request.auth.token.role == 'hr' &&
        request.auth.token.companyName == companyName;
    }

    match /companies/{companyId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isHrForCompany(resource.data.companyName);
      allow write: if false;
    }
  }
}
